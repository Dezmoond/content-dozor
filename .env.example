# Database
DATABASE_URL=postgresql+asyncpg://platform:platform@postgres:5432/platform
# DATABASE_URL=sqlite+aiosqlite:///./data/platform.db

REDIS_URL=redis://redis:6379/0

# llama.cpp servers (local GGUF on F:\DIPLOM_GGUF)
LLM_BACKEND=llamacpp
LLAMA_CPP_EXTREMISM_URL=http://127.0.0.1:8081
LLAMA_CPP_ENTITIES_URL=http://127.0.0.1:8081
LLAMA_CPP_VALIDATION_URL=http://127.0.0.1:8081
LLAMA_CPP_GGUF_DIR=F:/DIPLOM_GGUF
LLAMA_CPP_CTX=8192
LLAMA_CPP_NGL=99
# single = одна модель на GPU (RTX 4060 Ti 16GB); multi = 3 сервера (нужно >=24GB VRAM)
LLAMA_CPP_GPU_MODE=single

# Ollama (optional fallback if LLM_BACKEND=ollama)
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_EXTREMISM_MODEL=qwen-actual-run3-extremism
OLLAMA_ENTITIES_MODEL=qwen-newclass3run
OLLAMA_VALIDATION_MODEL=qwen25-7b-instruct

# Paths (host)
DIPLOM_ROOT=E:/CURSOR/DIPLOM
# Рантайм CSV реестров (по умолчанию analysis_platform/data/blacklist)
BLACKLIST_DIR=E:/CURSOR/DIPLOM/analysis_platform/data/blacklist
UPLOAD_DIR=./data/uploads

# Auth
JWT_SECRET=change-me-in-production

# Service URLs (docker internal)
AUTH_SERVICE_URL=http://auth:8001
CASES_SERVICE_URL=http://cases:8002
PARSERS_SERVICE_URL=http://parsers:8003
LLM_SERVICE_URL=http://llm:8004
REPORTS_SERVICE_URL=http://reports:8005

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

CHUNK_SIZE=300
CHUNK_OVERLAP=25

AUDIT_STORE_FULL_TEXT=false
